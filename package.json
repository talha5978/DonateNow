{
	"name": "donatenow",
	"description": "Right blood. Right donor. Right now.",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "react-router build",
		"dev": "react-router dev",
		"start": "react-router-serve ./build/server/index.js",
		"typecheck": "react-router typegen && tsc",
		"format": "prettier --write \"**/*.{js,ts,tsx,jsx,json,md,css,scss}\"",
		"gen-types": "pnpm dlx supabase gen types --schema public > ./app/types/database.ts --remote && prettier --write ./app/types/database.ts"
	},
	"lint-staged": {
		"**/*.{js,ts,tsx,jsx,json,md,css,scss}": [
			"prettier --write"
		]
	},
	"dependencies": {
		"@base-ui/react": "^1.9.0",
		"@fontsource-variable/geist": "^5.3.0",
		"@hookform/resolvers": "^7.0.3",
		"@react-router/node": "^8.5.1",
		"@react-router/serve": "^8.5.1",
		"@supabase/ssr": "^0.12.7",
		"@supabase/supabase-js": "^2.119.0",
		"@vercel/react-router": "^1.3.7",
		"class-variance-authority": "^0.7.1",
		"cn": "^0.5.2",
		"isbot": "^5.1.36",
		"lucide-react": "^1.70.0",
		"next-themes": "^0.4.6",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-hook-form": "^7.91.0",
		"react-router": "^8.5.1",
		"react-top-loading-bar": "^3.0.2",
		"shadcn": "^4.23.0",
		"sonner": "^2.0.8",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@react-router/dev": "^8.5.1",
		"@tailwindcss/vite": "^4.2.2",
		"@types/node": "^22",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.7",
		"husky": "^9.1.7",
		"prettier": "^3.9.10",
		"tailwindcss": "^4.2.2",
		"typescript": "^5.9.3",
		"vite": "^8.0.3"
	}
}
